            <img src="{{ 'tw-plates-pastel-flatlay.jpg' | asset_url }}" alt="" loading="lazy" decoding="async" width="480" height="640">
          </figure>
        </div>
      </div>
    </div>
  </div>
  <div class="mega-menu__footer">
    <button type="button" class="mega-menu__close" data-mega-close>Kapat</button>
  </div>
</div>

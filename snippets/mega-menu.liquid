{% comment %}
  Ürünler mega menü — header altında full-bleed panel + backdrop.
  Kategori / alt linkler Theme Editor’da linklist ile bağlanabilir; varsayılan metinler preview ile uyumlu.
{% endcomment %}
<div class="mega-menu" data-mega-menu id="kuuine-mega-menu" hidden>
  <div class="mega-menu__backdrop" data-mega-backdrop aria-hidden="true"></div>
  <div class="mega-menu__panel" role="navigation" aria-label="Ürünler">
    <div class="mega-menu__inner">
      <ul class="mega-menu__cats" role="list">
        <li>
          <button type="button" class="mega-menu__cat is-active" data-mega-cat="yeni" aria-expanded="true">
            Yeni Gelenler
          </button>
        </li>
        <li>
          <button type="button" class="mega-menu__cat" data-mega-cat="tum" aria-expanded="false">
            Tüm Ürünler
          </button>
        </li>
        <li>
          <button type="button" class="mega-menu__cat" data-mega-cat="sofra" aria-expanded="false">
            Sofra Ürünleri
          </button>
        </li>
        <li>
          <button type="button" class="mega-menu__cat" data-mega-cat="mutfak" aria-expanded="false">
            Mutfak Gereçleri
          </button>
        </li>
        <li>
          <button type="button" class="mega-menu__cat" data-mega-cat="banyo" aria-expanded="false">
            Banyo Aksesuarları
          </button>
        </li>
        <li>
          <button type="button" class="mega-menu__cat" data-mega-cat="emaye" aria-expanded="false">
            Emaye
          </button>
        </li>
        <li>
          <button type="button" class="mega-menu__cat" data-mega-cat="outlet" aria-expanded="false">
            Outlet
          </button>
        </li>
      </ul>

      <div class="mega-menu__subs-wrap">
        <ul class="mega-menu__subs is-active" data-mega-subs="yeni" role="list" aria-hidden="false">
          <li><a href="{{ routes.all_products_collection_url }}">Yemek Takımı</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Borosilikat Cam Bardak</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Su ve Meşrubat Bardağı</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Kahvaltı Takımı</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Kahve Yanı Su Bardağı</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">2 Kişilik Fincan Takımı</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Kahve Fincanı Takımı</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Çay Bardağı</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Sunumluklar</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Porselen Tabaklar</a></li>

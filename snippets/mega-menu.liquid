          <li><a href="{{ routes.all_products_collection_url }}">Çay Setleri</a></li>
        </ul>
        <ul class="mega-menu__subs" data-mega-subs="tum" role="list" aria-hidden="true">
          <li><a href="{{ routes.all_products_collection_url }}">Tüm Koleksiyon</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Yemek Takımı</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Tabaklar</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Bardaklar</a></li>

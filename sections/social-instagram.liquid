<section
  class="instagram tw:bg-bg tw:px-0 tw:pb-5 tw:pt-intro tw:text-center"
  {{ section.shopify_attributes }}
>
  <h2 class="instagram__title tw:mb-1.5 tw:font-display tw:text-display tw:font-normal tw:tracking-display tw:text-ink">
    {{ section.settings.title }}
  </h2>
  {% if section.settings.handle != blank %}
    <p class="instagram__handle tw:mb-7 tw:opacity-70">
      <a href="{{ section.settings.link }}">{{ section.settings.handle }}</a>
    </p>
  {% endif %}
  <div class="instagram__grid tw:grid tw:grid-cols-3 tw:gap-1 tw:lg:grid-cols-6">
    {% for block in section.blocks %}
      <a
        class="tw:aspect-square tw:overflow-hidden tw:bg-soft"
        href="{{ block.settings.link | default: section.settings.link }}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 600
            | image_tag:
              loading: 'lazy', decoding: 'async',
              alt: block.settings.alt | default: 'Instagram',
              class: 'tw:size-full tw:object-cover tw:transition-transform tw:duration-500 tw:hover:scale-105'
          }}
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Instagram grid",
  "tag": "section",
  "class": "section-instagram",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Başlık",
      "default": "İlham almaya devam edin"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Hesap adı",
      "default": "@markaniz"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Profil bağlantısı"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Görsel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Görsel" },
        { "type": "text", "id": "alt", "label": "Alt metin" },
        { "type": "url", "id": "link", "label": "Bağlantı" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}

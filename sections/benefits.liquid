<section
  class="benefits tw:bg-bg tw:px-pad-x tw:py-section-lg tw:text-center"
  {{ section.shopify_attributes }}
>
  {% if section.settings.eyebrow != blank %}
    <p class="benefits__eyebrow tw:mb-3 tw:text-eyebrow tw:uppercase tw:tracking-eyebrow">{{ section.settings.eyebrow }}</p>
  {% endif %}
  {% if section.settings.title != blank %}
    <h2 class="benefits__title tw:mb-4 tw:font-display tw:text-display tw:font-normal tw:tracking-display tw:text-ink">
      {{ section.settings.title }}
    </h2>
  {% endif %}
  {% if section.settings.text != blank %}
    <p class="benefits__intro tw:mx-auto tw:mb-14 tw:max-w-[48ch] tw:text-body tw:text-muted">
      {{ section.settings.text }}
    </p>
  {% endif %}

  <div class="benefits__grid tw:grid tw:grid-cols-2 tw:gap-x-1 tw:gap-y-4 tw:text-left tw:lg:grid-cols-5">
    {% for block in section.blocks %}
      <article class="benefit-card" {{ block.shopify_attributes }}>
        <div class="benefit-card__media tw:mb-3.5 tw:aspect-[3/4] tw:overflow-hidden tw:bg-soft">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: loading: 'lazy', decoding: 'async', alt: block.settings.title, class: 'tw:size-full tw:object-cover'
            }}
          {% endif %}
        </div>
        <div class="benefit-card__body tw:pr-2 tw:lg:pr-3">
          <h3 class="tw:mb-1.5 tw:text-sm tw:font-medium">{{ block.settings.title }}</h3>
          <p class="tw:text-card tw:text-muted">{{ block.settings.text }}</p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "tag": "section",
  "class": "section-benefits",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Üst başlık",
      "default": "Dayanmak için tasarlandı"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Başlık",
      "default": "Ömürlük tasarlandı"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Giriş metni",
      "default": "Konfor, düşünülmüş tasarım ve kalıcı kaliteyi dengeleyen özenle üretilmiş bir koleksiyon."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Görsel" },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Duraksamaya davet" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Metin",
          "default": "Sofra anlarını güzelleştiren, paylaşımı teşvik eden tasarımlar."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "title": "Duraksamaya davet" } },
        { "type": "benefit", "settings": { "title": "Kusursuz işçilik" } },
        { "type": "benefit", "settings": { "title": "Kalıcı olmak için" } },
        { "type": "benefit", "settings": { "title": "Keyif için tasarlandı" } },
        { "type": "benefit", "settings": { "title": "Atölye el işçiliği" } }
      ]
    }
  ]
}
{% endschema %}

{%- comment -%}
  Koleksiyon landing (atelier lookbook): hero → manifesto → 3 look → kategori → ürünler
{%- endcomment -%}
<section
  class="catalog"
  data-shopify-section="main-collection"
  data-catalog
  {{ section.shopify_attributes }}
>
  {%- liquid
    assign chip_blocks = section.blocks | where: 'type', 'chip'
  -%}

  {% if section.settings.show_landing %}
    <div class="catalog-landing" data-catalog-landing>
      <div class="catalog-atelier__hero">
        <div class="catalog-atelier__media">
          {% if section.settings.landing_video != blank %}
            {% render 'lazy-video', video: section.settings.landing_video, class: 'catalog-atelier__video', mode: 'auto' %}
          {% elsif section.settings.landing_video_poster != blank %}
            {{
              section.settings.landing_video_poster
              | image_url: width: 2400
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                decoding: 'async',
                widths: '800,1400,2000,2400',
                sizes: '100vw',
                alt: section.settings.landing_eyebrow | default: collection.title
            }}
          {% else %}
            <div class="catalog-landing__placeholder" aria-hidden="true"></div>
          {% endif %}
        </div>
        <div class="catalog-atelier__shade" aria-hidden="true"></div>
        <div class="catalog-atelier__hero-inner">
          {% if section.settings.landing_eyebrow != blank %}
            <p class="catalog-atelier__eyebrow">{{ section.settings.landing_eyebrow }}</p>
          {% endif %}
          <h1 class="catalog-atelier__title">
            {% if section.settings.landing_title != blank %}
              {{ section.settings.landing_title | newline_to_br }}
            {% else %}
              {{ collection.title }}
            {% endif %}
          </h1>
          {% if section.settings.landing_text != blank %}
            <p class="catalog-atelier__lead">{{ section.settings.landing_text }}</p>
          {% elsif collection.description != blank %}
            <p class="catalog-atelier__lead">{{ collection.description | strip_html }}</p>
          {% endif %}
          <a class="catalog-atelier__cta" href="#catalog-shop">Koleksiyonu keşfet</a>
        </div>
        <p class="catalog-atelier__scroll" aria-hidden="true">Kaydır</p>
      </div>

      {% if section.settings.manifesto_text != blank %}
        <div class="catalog-atelier__note" data-catalog-reveal>
          <div class="catalog-atelier__note-inner">
            <p class="catalog-atelier__note-label">{{ section.settings.manifesto_label | default: 'Atelier' }}</p>
            <p class="catalog-atelier__note-text">{{ section.settings.manifesto_text }}</p>
          </div>
        </div>
      {% endif %}

      <div class="catalog-atelier__looks">
        <article class="catalog-look" data-catalog-reveal>
          <figure class="catalog-look__media">
            {% if section.settings.split1_image != blank %}
              {{
                section.settings.split1_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  decoding: 'async',
                  widths: '480,720,960,1200',
                  sizes: '(min-width: 900px) 33vw, 100vw',
                  alt: section.settings.split1_title | default: collection.title
              }}
            {% else %}
              <div class="catalog-landing__placeholder" aria-hidden="true"></div>
            {% endif %}
          </figure>
          <div class="catalog-look__shade" aria-hidden="true"></div>
          <div class="catalog-look__caption">
            <span class="catalog-look__index">01</span>
            {% if section.settings.split1_eyebrow != blank %}
              <p class="catalog-look__eyebrow">{{ section.settings.split1_eyebrow }}</p>
            {% endif %}
            {% if section.settings.split1_title != blank %}
              <h2 class="catalog-look__title">{{ section.settings.split1_title | newline_to_br }}</h2>
            {% endif %}
            {% if section.settings.split1_text != blank %}
              <p class="catalog-look__text">{{ section.settings.split1_text }}</p>
            {% endif %}
          </div>
        </article>

        <article class="catalog-look" data-catalog-reveal>
          <figure class="catalog-look__media">
            {% if section.settings.split2_video != blank %}
              {% render 'lazy-video',
                video: section.settings.split2_video,
                class: 'catalog-look__video',
                mode: 'auto'
              %}
            {% elsif section.settings.split2_image != blank %}
              {{
                section.settings.split2_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  decoding: 'async',
                  widths: '480,720,960,1200',
                  sizes: '(min-width: 900px) 33vw, 100vw',
                  alt: section.settings.split2_title | default: collection.title
              }}
            {% else %}
              <div class="catalog-landing__placeholder" aria-hidden="true"></div>
            {% endif %}
          </figure>
          <div class="catalog-look__shade" aria-hidden="true"></div>
          <div class="catalog-look__caption">
            <span class="catalog-look__index">02</span>
            {% if section.settings.split2_eyebrow != blank %}
              <p class="catalog-look__eyebrow">{{ section.settings.split2_eyebrow }}</p>
            {% endif %}
            {% if section.settings.split2_title != blank %}
              <h2 class="catalog-look__title">{{ section.settings.split2_title | newline_to_br }}</h2>
            {% endif %}
            {% if section.settings.split2_text != blank %}
              <p class="catalog-look__text">{{ section.settings.split2_text }}</p>
            {% endif %}
          </div>
        </article>

        <article class="catalog-look" data-catalog-reveal>
          <figure class="catalog-look__media">
            {% if section.settings.split3_image != blank %}
              {{
                section.settings.split3_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  decoding: 'async',
                  widths: '480,720,960,1200',
                  sizes: '(min-width: 900px) 33vw, 100vw',
                  alt: section.settings.split3_title | default: collection.title
              }}
            {% else %}
              <div class="catalog-landing__placeholder" aria-hidden="true"></div>
            {% endif %}
          </figure>
          <div class="catalog-look__shade" aria-hidden="true"></div>
          <div class="catalog-look__caption">
            <span class="catalog-look__index">03</span>
            {% if section.settings.split3_eyebrow != blank %}
              <p class="catalog-look__eyebrow">{{ section.settings.split3_eyebrow }}</p>
            {% endif %}
            {% if section.settings.split3_title != blank %}
              <h2 class="catalog-look__title">{{ section.settings.split3_title | newline_to_br }}</h2>
            {% endif %}
            {% if section.settings.split3_text != blank %}
              <p class="catalog-look__text">{{ section.settings.split3_text }}</p>
            {% endif %}
          </div>
        </article>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_categories %}
    <div class="catalog__cats-wrap">
      <ul class="catalog__cats" data-catalog-chips role="list">
        <li>
          <button type="button" class="catalog__cat is-active" data-catalog-chip="all">Tümü</button>
        </li>
        {% for block in chip_blocks %}
          <li {{ block.shopify_attributes }}>
            <button type="button" class="catalog__cat" data-catalog-chip="{{ block.settings.label | handle }}">
              {{ block.settings.label }}
            </button>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  <div class="catalog__toolbar" id="catalog-shop">
    <div class="catalog__meta">
      <p class="catalog__category" data-catalog-category>{{ collection.title }}</p>
      <p class="catalog__count">{{ collection.products_count }} ürün</p>
    </div>
    <div class="catalog__tools">
      <label class="catalog__sort">
        <span class="catalog__sort-label">Sırala</span>
        <select name="sort_by" data-catalog-sort aria-label="Sıralama">
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
              {{ option.name }}
            </option>
          {% endfor %}
        </select>
      </label>

      <button
        type="button"
        class="catalog__filter-btn"
        data-catalog-filter-open
        aria-haspopup="dialog"
        aria-controls="catalog-filter-modal"
      >
        <span class="catalog__filter-label">
          Filtrele
          <span class="catalog__filter-count" data-catalog-filter-count hidden></span>
        </span>
      </button>

      <div class="catalog__view catalog__view--mobile" role="group" aria-label="Mobil görünüm">
        <button
          type="button"
          class="catalog__view-btn"
          data-catalog-view="1"
          aria-pressed="false"
          aria-label="Tekli"
        >
          <svg viewBox="0 0 10 14" width="12" height="14" aria-hidden="true">
            <rect x="0" y="0" width="10" height="14" fill="currentColor"/>
          </svg>
        </button>
        <button
          type="button"
          class="catalog__view-btn is-active"
          data-catalog-view="2"
          aria-pressed="true"
          aria-label="İkili"
        >
          <svg viewBox="0 0 14 14" width="14" height="14" aria-hidden="true">
            <rect x="0" y="0" width="5.5" height="14" fill="currentColor"/>
            <rect x="8.5" y="0" width="5.5" height="14" fill="currentColor"/>
          </svg>
        </button>
      </div>
      <div class="catalog__view catalog__view--desktop" role="group" aria-label="Masaüstü görünüm">
        <button
          type="button"
          class="catalog__view-btn"
          data-catalog-view="3"
          aria-pressed="false"
          aria-label="3 kolon"
        >
          <svg viewBox="0 0 18 14" width="18" height="14" aria-hidden="true">
            <rect x="0" y="0" width="4" height="14" fill="currentColor"/>
            <rect x="7" y="0" width="4" height="14" fill="currentColor"/>
            <rect x="14" y="0" width="4" height="14" fill="currentColor"/>
          </svg>
        </button>
        <button
          type="button"
          class="catalog__view-btn is-active"
          data-catalog-view="4"
          aria-pressed="true"
          aria-label="4 kolon"
        >
          <svg viewBox="0 0 22 14" width="22" height="14" aria-hidden="true">
            <rect x="0" y="0" width="3.5" height="14" fill="currentColor"/>
            <rect x="6" y="0" width="3.5" height="14" fill="currentColor"/>
            <rect x="12" y="0" width="3.5" height="14" fill="currentColor"/>
            <rect x="18" y="0" width="3.5" height="14" fill="currentColor"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {% paginate collection.products by section.settings.products_per_page %}
    <div class="catalog__layout">
      <div class="catalog__grid catalog__grid--cols-2 catalog__grid--cols-4" data-catalog-grid>
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p class="catalog__empty">Bu koleksiyonda henüz ürün yok.</p>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="catalog__pager" aria-label="Sayfalama">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" aria-label="Önceki sayfa">‹</a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {% elsif part.title == paginate.current_page %}
              <span class="is-current" aria-current="page">{{ part.title }}</span>
            {% else %}
              <span>{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" aria-label="Sonraki sayfa">›</a>
          {% endif %}
        </nav>
      {% endif %}
    </div>
  {% endpaginate %}

  <div
    class="catalog-modal"
    id="catalog-filter-modal"
    data-catalog-filter-modal
    hidden
    aria-hidden="true"
  >
    <div class="catalog-modal__backdrop" data-catalog-filter-close></div>
    <div
      class="catalog-modal__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="catalog-filter-title"
    >
      <div class="catalog-modal__head">
        <h2 id="catalog-filter-title">Filtrele</h2>
        <button type="button" class="catalog-modal__x" data-catalog-filter-close aria-label="Kapat">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"/>
          </svg>
        </button>
      </div>
      <div class="catalog-modal__body">
        <div class="catalog__filter-group">
          <h3>Durum</h3>
          <label><input type="checkbox" data-catalog-filter="available" checked> Stokta</label>
          <label><input type="checkbox" data-catalog-filter="new"> Yeni</label>
          <label><input type="checkbox" data-catalog-filter="sale"> İndirim</label>
        </div>
        <div class="catalog__filter-group">
          <h3>Malzeme</h3>
          <label><input type="checkbox" data-catalog-filter="seramik"> Seramik</label>
          <label><input type="checkbox" data-catalog-filter="cam"> Cam</label>
          <label><input type="checkbox" data-catalog-filter="emaye"> Emaye</label>
          <label><input type="checkbox" data-catalog-filter="ahsap"> Ahşap</label>
        </div>
        <div class="catalog__filter-group">
          <h3>Fiyat</h3>
          <label><input type="checkbox" data-catalog-filter="p1"> 0 – 1.000 ₺</label>
          <label><input type="checkbox" data-catalog-filter="p2"> 1.000 – 3.000 ₺</label>
          <label><input type="checkbox" data-catalog-filter="p3"> 3.000 ₺+</label>
        </div>
      </div>
      <div class="catalog-modal__foot">
        <button type="button" class="catalog-modal__reset" data-catalog-filter-reset>Temizle</button>
        <button type="button" class="catalog-modal__apply" data-catalog-filter-close>Uygula</button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_landing",
      "label": "Üst ürün tanıtım landing",
      "default": true
    },
    { "type": "header", "content": "Hero" },
    { "type": "video", "id": "landing_video", "label": "Landing video" },
    { "type": "image_picker", "id": "landing_video_poster", "label": "Video yoksa görsel / poster" },
    { "type": "text", "id": "landing_eyebrow", "label": "Üst etiket", "default": "Koleksiyon" },
    { "type": "textarea", "id": "landing_title", "label": "Başlık", "default": "Sofra zarafeti\niçin tasarlandı" },
    {
      "type": "textarea",
      "id": "landing_text",
      "label": "Kısa metin",
      "default": "Özenli sofralar için düşünülmüş cam, seramik ve ahşap seçkiler."
    },
    { "type": "header", "content": "Manifesto" },
    { "type": "text", "id": "manifesto_label", "label": "Etiket", "default": "Atelier" },
    {
      "type": "textarea",
      "id": "manifesto_text",
      "label": "Metin",
      "default": "Her parça, paylaşımı derinleştirmek ve sofrayı bir ritüele dönüştürmek için seçildi."
    },
    { "type": "header", "content": "Look 01" },
    { "type": "text", "id": "split1_eyebrow", "label": "Üst etiket", "default": "Seramik" },
    { "type": "textarea", "id": "split1_title", "label": "Başlık", "default": "Işığı tutan formlar" },
    {
      "type": "textarea",
      "id": "split1_text",
      "label": "Metin",
      "default": "Sakin silüetler, yumuşak stoneware."
    },
    { "type": "image_picker", "id": "split1_image", "label": "Görsel" },
    { "type": "header", "content": "Look 02" },
    { "type": "text", "id": "split2_eyebrow", "label": "Üst etiket", "default": "Cam" },
    { "type": "textarea", "id": "split2_title", "label": "Başlık", "default": "Amber & kristal" },
    {
      "type": "textarea",
      "id": "split2_text",
      "label": "Metin",
      "default": "Işığı sofraya taşıyan sade camlar."
    },
    { "type": "video", "id": "split2_video", "label": "Video" },
    { "type": "image_picker", "id": "split2_image", "label": "Görsel (video yoksa)" },
    { "type": "header", "content": "Look 03" },
    { "type": "text", "id": "split3_eyebrow", "label": "Üst etiket", "default": "Sofra" },
    { "type": "textarea", "id": "split3_title", "label": "Başlık", "default": "Paylaşım anı" },
    {
      "type": "textarea",
      "id": "split3_text",
      "label": "Metin",
      "default": "Birlikte kurulan masalar için."
    },
    { "type": "image_picker", "id": "split3_image", "label": "Görsel" },
    { "type": "header", "content": "Liste" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Yedek açıklama",
      "default": "Sofra, cam ve seramik seçkiler — özenli sofralar için zamansız formlar."
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Sayfa başına ürün",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_categories",
      "label": "Kategori sekmeleri",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Kategori",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiket", "default": "Tabaklar" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection products",
      "blocks": [
        { "type": "chip", "settings": { "label": "Tabaklar" } },
        { "type": "chip", "settings": { "label": "Bardaklar" } },
        { "type": "chip", "settings": { "label": "Tepsiler" } },
        { "type": "chip", "settings": { "label": "Sofra setleri" } }
      ]
    }
  ]
}
{% endschema %}

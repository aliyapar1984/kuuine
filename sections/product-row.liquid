<section class="product-row" {{ section.shopify_attributes }}>
  <div class="product-row__grid">
    <div class="product-row__content">
      <h2 class="product-row__title">{{ section.settings.title }}</h2>
    </div>

    {% if section.blocks.size > 0 %}
      <ul class="product-row__tabs" data-product-filters>
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}>
            <button type="button" class="{% if forloop.first %}is-active{% endif %}">
              {{ block.settings.label }}
            </button>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  <div class="product-row__carousel">
    <div class="product-row__track">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for i in (1..3) %}
          <article class="product-card">
            <div class="product-card__media"></div>
            <div class="product-card__footer">
              <h3 class="product-card__title">Ürün adı</h3>
              <p class="product-card__brand">Koleksiyon</p>
              <div class="product-card__meta">
                <p class="product-card__fabric">Kumaş</p>
                <p class="product-card__price">{{ 0 | money }}</p>
              </div>
              <button type="button" class="product-card__add">Sepete ekle</button>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product row",
  "tag": "section",
  "class": "section-product-row",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Başlık",
      "default": "Yeni Ürünler"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Koleksiyon"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Gösterilecek ürün sayısı",
      "min": 3,
      "max": 16,
      "step": 1,
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filtre etiketi",
      "settings": [
        { "type": "text", "id": "label", "label": "Etiket", "default": "Tümü" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product row",
      "blocks": [
        { "type": "filter", "settings": { "label": "Tümü" } },
        { "type": "filter", "settings": { "label": "Tabaklar" } },
        { "type": "filter", "settings": { "label": "Bardaklar" } },
        { "type": "filter", "settings": { "label": "Tepsiler" } },
        { "type": "filter", "settings": { "label": "Sofra setleri" } }
      ]
    }
  ]
}
{% endschema %}

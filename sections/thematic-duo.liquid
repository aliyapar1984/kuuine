<section
  class="thematic-duo tw:bg-bg tw:px-pad-x tw:py-section"
  {{ section.shopify_attributes }}
>
  <div class="thematic-duo__intro tw:mx-auto tw:max-w-[720px] tw:pb-duo-intro tw:text-center">
    {% if section.settings.eyebrow != blank %}
      <p class="thematic-duo__eyebrow tw:mb-6 tw:text-eyebrow tw:uppercase tw:tracking-eyebrow-wider tw:text-stone">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}
    {% if section.settings.title != blank %}
      <h2 class="thematic-duo__title tw:mb-5 tw:font-display tw:text-display tw:font-normal tw:tracking-display tw:text-ink">
        {{ section.settings.title | newline_to_br }}
      </h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="thematic-duo__text tw:mx-auto tw:mb-8 tw:max-w-[54ch] tw:text-body tw:tracking-body tw:text-stone">
        {{ section.settings.text }}
      </p>
    {% endif %}
    {% if section.settings.button_label != blank %}
      {% assign duo_cta_href = section.settings.button_link | default: routes.all_products_collection_url %}
      <a class="btn thematic-duo__cta" href="{{ duo_cta_href }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>

  <div class="thematic-duo__media tw:grid tw:grid-cols-1 tw:gap-1 tw:lg:grid-cols-[2fr_1fr]">
    <figure class="thematic-duo__figure thematic-duo__figure--wide">
      {% if section.settings.image_wide != blank %}
        {{
          section.settings.image_wide
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy', decoding: 'async',
            sizes: '(min-width: 900px) 66vw, 100vw',
            widths: '600, 900, 1200, 1600',
            alt: section.settings.image_wide_alt | default: section.settings.wide_title
        }}
      {% endif %}
      <div class="thematic-duo__overlay" aria-hidden="true"></div>
      {% if section.settings.wide_title != blank or section.settings.wide_text != blank or section.settings.wide_button_label != blank %}
        <div class="thematic-duo__caption">
          {% if section.settings.wide_eyebrow != blank %}
            <p class="thematic-duo__caption-eyebrow">{{ section.settings.wide_eyebrow }}</p>
          {% endif %}
          {% if section.settings.wide_title != blank %}
            <h3 class="thematic-duo__caption-title">{{ section.settings.wide_title | newline_to_br }}</h3>
          {% endif %}
          {% if section.settings.wide_text != blank %}
            <p class="thematic-duo__caption-text">{{ section.settings.wide_text }}</p>
          {% endif %}
          {% if section.settings.wide_button_label != blank %}
            {% assign wide_cta_href = section.settings.wide_button_link | default: routes.all_products_collection_url %}
            <a class="btn btn--ghost-light" href="{{ wide_cta_href }}">{{ section.settings.wide_button_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </figure>
    <figure class="thematic-duo__figure thematic-duo__figure--tall">
      {% if section.settings.image_tall != blank %}
        {{
          section.settings.image_tall
          | image_url: width: 900
          | image_tag:
            loading: 'lazy', decoding: 'async',
            sizes: '(min-width: 900px) 33vw, 100vw',
            widths: '400, 600, 900',
            alt: section.settings.image_tall_alt | default: section.settings.tall_title
        }}
      {% endif %}
      <div class="thematic-duo__overlay" aria-hidden="true"></div>
      {% if section.settings.tall_title != blank or section.settings.tall_text != blank or section.settings.tall_button_label != blank %}
        <div class="thematic-duo__caption">
          {% if section.settings.tall_eyebrow != blank %}
            <p class="thematic-duo__caption-eyebrow">{{ section.settings.tall_eyebrow }}</p>
          {% endif %}
          {% if section.settings.tall_title != blank %}
            <h3 class="thematic-duo__caption-title">{{ section.settings.tall_title | newline_to_br }}</h3>
          {% endif %}
          {% if section.settings.tall_text != blank %}
            <p class="thematic-duo__caption-text">{{ section.settings.tall_text }}</p>
          {% endif %}
          {% if section.settings.tall_button_label != blank %}
            {% assign tall_cta_href = section.settings.tall_button_link | default: routes.all_products_collection_url %}
            <a class="btn btn--ghost-light" href="{{ tall_cta_href }}">{{ section.settings.tall_button_label }}</a>
          {% endif %}
        </div>
      {% endif %}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Thematic duo",
  "tag": "section",
  "class": "section-thematic-duo",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Üst etiket",
      "default": "Züccaciye koleksiyon"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Başlık",
      "default": "Sofra zarafeti\niçin tasarlandı"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Metin",
      "default": "Özenli sofralar için tasarlandı. Her detayı düşünülmüş, ışığı taşıyan formlar."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Buton metni",
      "default": "Züccaciye koleksiyonu keşfet"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Buton bağlantısı"
    },
    {
      "type": "header",
      "content": "Geniş panel"
    },
    {
      "type": "image_picker",
      "id": "image_wide",
      "label": "Geniş görsel"
    },
    {
      "type": "text",
      "id": "image_wide_alt",
      "label": "Geniş görsel alt metni"
    },
    {
      "type": "text",
      "id": "wide_eyebrow",
      "label": "Geniş panel üst etiket",
      "default": "Seramik"
    },
    {
      "type": "textarea",
      "id": "wide_title",
      "label": "Geniş panel başlık",
      "default": "Işığı tutan\nformlar"
    },
    {
      "type": "textarea",
      "id": "wide_text",
      "label": "Geniş panel metin",
      "default": "Soft stoneware tabaklar — paylaşımı davet eden sakin silüetler ve zamansız dokunuş."
    },
    {
      "type": "text",
      "id": "wide_button_label",
      "label": "Geniş panel buton",
      "default": "Tabakları keşfet"
    },
    {
      "type": "url",
      "id": "wide_button_link",
      "label": "Geniş panel buton bağlantısı"
    },
    {
      "type": "header",
      "content": "Dikey panel"
    },
    {
      "type": "image_picker",
      "id": "image_tall",
      "label": "Dikey görsel"
    },
    {
      "type": "text",
      "id": "image_tall_alt",
      "label": "Dikey görsel alt metni"
    },
    {
      "type": "text",
      "id": "tall_eyebrow",
      "label": "Dikey panel üst etiket",
      "default": "Doğal doku"
    },
    {
      "type": "textarea",
      "id": "tall_title",
      "label": "Dikey panel başlık",
      "default": "Ahşap &\nseramik"
    },
    {
      "type": "textarea",
      "id": "tall_text",
      "label": "Dikey panel metin",
      "default": "Sofra ritüeline sıcaklık katan doğal malzemeler."
    },
    {
      "type": "text",
      "id": "tall_button_label",
      "label": "Dikey panel buton",
      "default": "Detayı gör"
    },
    {
      "type": "url",
      "id": "tall_button_link",
      "label": "Dikey panel buton bağlantısı"
    }
  ],
  "presets": [{ "name": "Thematic duo" }]
}
{% endschema %}

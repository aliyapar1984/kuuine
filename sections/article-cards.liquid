<section
  class="journal tw:bg-kuuine tw:px-[var(--pad-x)] tw:py-[clamp(3rem,6vw,5rem)]"
  {{ section.shopify_attributes }}
>
  <div class="journal__head tw:mb-7 tw:flex tw:items-baseline tw:justify-between">
    <h2 class="journal__title tw:font-display tw:text-[clamp(28px,3.4vw,38px)] tw:font-normal tw:leading-[1.2] tw:tracking-[0.03em] tw:text-kuuine-ink">
      {{ section.settings.title }}
    </h2>
    {% if section.settings.blog != blank %}
      <a class="btn--text" href="{{ section.settings.blog.url }}">{{ section.settings.view_all_label }}</a>
    {% endif %}
  </div>
  <div class="journal__grid tw:grid tw:grid-cols-1 tw:gap-1 tw:lg:grid-cols-2">
    {% if section.settings.blog != blank %}
      {% for article in section.settings.blog.articles limit: section.settings.articles_to_show %}
        <article class="journal-card">
          <a href="{{ article.url }}" class="journal-card__media tw:mb-3.5 tw:aspect-[16/10] tw:overflow-hidden tw:bg-kuuine-soft">
            {% if article.image %}
              {{
                article.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', alt: article.title, class: 'tw:size-full tw:object-cover'
              }}
            {% endif %}
          </a>
          <h3 class="tw:my-2 tw:text-[1.25rem] tw:font-normal tw:leading-[1.3]">
            <a href="{{ article.url }}">{{ article.title }}</a>
          </h3>
          <a class="btn--text" href="{{ article.url }}">{{ section.settings.read_label }}</a>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Journal cards",
  "tag": "section",
  "class": "section-article-cards",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Başlık",
      "default": "Son Yazılar"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "articles_to_show",
      "label": "Gösterilecek yazı sayısı",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Tümünü gör etiketi",
      "default": "Tümünü gör"
    },
    {
      "type": "text",
      "id": "read_label",
      "label": "Okuma etiketi",
      "default": "Yazıyı oku"
    }
  ],
  "presets": [{ "name": "Journal cards" }]
}
{% endschema %}

<section class="testimonials" {{ section.shopify_attributes }}>
  {% if section.settings.title != blank %}
    <h2 class="testimonials__title">{{ section.settings.title }}</h2>
  {% endif %}

  <ul class="testimonials__info">
    {% for block in section.blocks %}
      {% case block.settings.icon %}
        {% when 'shipping' %}
          {% assign icon_file = 'lottie-shipping.json' %}
        {% when 'store' %}
          {% assign icon_file = 'lottie-stores.json' %}
        {% when 'support' %}
          {% assign icon_file = 'lottie-support.json' %}
        {% else %}
          {% assign icon_file = 'lottie-secure.json' %}
      {% endcase %}
      <li class="testimonials__info-item" {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}
          <a class="testimonials__info-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.title }}"></a>
        {% endif %}
        <span
          class="testimonials__info-icon"
          data-lottie
          data-lottie-src="{{ icon_file | asset_url }}"
          data-lottie-idle="end"
          aria-hidden="true"
        ></span>
        <span class="testimonials__info-heading">{{ block.settings.title }}</span>
        {% if block.settings.text != blank %}
          <p class="testimonials__info-text">{{ block.settings.text }}</p>
        {% endif %}
        <span
          class="testimonials__info-arrow"
          data-lottie
          data-lottie-src="{{ 'lottie-arrow.json' | asset_url }}"
          data-lottie-idle="start"
          aria-hidden="true"
        ></span>
      </li>
    {% endfor %}
  </ul>
</section>

{% schema %}
{
  "name": "Yorumlar / Bilgi şeridi",
  "tag": "section",
  "class": "section-testimonials",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Bölüm başlığı (opsiyonel)",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Bilgi",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "İkon",
          "options": [
            { "value": "payment", "label": "Güvenli ödeme" },
            { "value": "shipping", "label": "Kargo" },
            { "value": "store", "label": "Mağaza" },
            { "value": "support", "label": "Destek" }
          ],
          "default": "payment"
        },
        { "type": "text", "id": "title", "label": "Başlık", "default": "Güvenli ödeme" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Metin",
          "default": "Ödeme bilgileriniz güvenle işlenir; güvenliğiniz önceliğimizdir."
        },
        { "type": "url", "id": "link", "label": "Bağlantı" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bilgi şeridi",
      "blocks": [
        {
          "type": "info",
          "settings": {
            "icon": "payment",
            "title": "Güvenli ödeme",
            "text": "Ödeme bilgileriniz güvenle işlenir; güvenliğiniz önceliğimizdir."
          }
        },
        {
          "type": "info",
          "settings": {
            "icon": "shipping",
            "title": "Ücretsiz kargo",
            "text": "Belirli tutarın üzerindeki siparişlerde ücretsiz kargo ve iade."
          }
        },
        {
          "type": "info",
          "settings": {
            "icon": "store",
            "title": "Mağazalar",
            "text": "Mağazalarımızı keşfedin ve size en yakın noktayı bulun."
          }
        },
        {
          "type": "info",
          "settings": {
            "icon": "support",
            "title": "Destek",
            "text": "Sorularınız için buradayız; ürünlerimiz hakkında size yardımcı olmaktan mutluluk duyarız."
          }
        }
      ]
    }
  ]
}
{% endschema %}

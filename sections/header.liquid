<header
  class="site-header {% if section.settings.transparent_over_home and template.name == 'index' %}site-header--over-hero{% else %}site-header--solid{% endif %}"
  data-site-header
  {{ section.shopify_attributes }}
>
  <div class="site-header__inner">
    <div class="site-header__left">
      <button
        type="button"
        class="menu-toggle"
        data-nav-drawer-open
        aria-label="Menü"
        aria-haspopup="dialog"
        aria-controls="kuuine-nav-drawer"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
      <a href="{{ routes.root_url }}" class="logo" aria-label="{{ section.settings.logo_text | default: 'kuuine' }}">
        <span class="logo__mark">
          {% if section.settings.logo_icon != blank %}
            {{
              section.settings.logo_icon
              | image_url: width: 112
              | image_tag: class: 'logo__icon logo__icon--default', loading: 'eager', alt: ''
            }}
          {% else %}
            <img class="logo__icon logo__icon--default" src="{{ 'swan-logo-dark.svg' | asset_url }}" alt="" width="22" height="22">
          {% endif %}
          {% if section.settings.logo_icon_light != blank %}
            {{
              section.settings.logo_icon_light
              | image_url: width: 112
              | image_tag: class: 'logo__icon logo__icon--light', loading: 'eager', alt: ''
            }}
          {% else %}
            <img class="logo__icon logo__icon--light" src="{{ 'swan-logo.svg' | asset_url }}" alt="" width="22" height="22">
          {% endif %}
        </span>
        <span class="logo__wordmark">
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 360
              | image_tag: class: 'logo__img logo__img--default', loading: 'eager', alt: section.settings.logo_text | default: 'kuuine'
            }}
          {% else %}
            <img class="logo__img logo__img--default" src="{{ 'kuuine.svg' | asset_url }}" alt="{{ section.settings.logo_text | default: 'kuuine' }}" width="120" height="33">
          {% endif %}
          {% if section.settings.logo_light != blank %}
            {{
              section.settings.logo_light
              | image_url: width: 360
              | image_tag: class: 'logo__img logo__img--light', loading: 'eager', alt: ''
            }}
          {% else %}
            <img class="logo__img logo__img--light" src="{{ 'kuuine-white.svg' | asset_url }}" alt="" width="120" height="33">
          {% endif %}
        </span>
      </a>
      <nav class="site-header__nav" aria-label="Primary">
        {% for link in section.settings.menu.links %}
          {% assign title_down = link.title | downcase %}
          {% if title_down == 'ürünler' or title_down == 'urunler' or title_down == 'products' or title_down == 'shop' %}
            {% assign mega_href = link.url %}
            {% if mega_href == blank or mega_href == '/' or mega_href == '#' %}
              {% assign mega_href = routes.all_products_collection_url %}
            {% endif %}
            <div class="nav-item nav-item--mega" data-mega-trigger-wrap>
              <a
                class="nav-link"
                href="{{ mega_href }}"
                data-mega-trigger
                aria-expanded="false"
                aria-controls="kuuine-mega-menu"
              >
                {{ link.title }}
              </a>
            </div>
          {% else %}
            {% assign nav_href = link.url %}
            {% if title_down == 'indirim' or title_down == 'katalog' or title_down == 'sale' or title_down == 'catalog' %}
              {% if nav_href == blank or nav_href == '/' or nav_href == '#' %}
                {% assign nav_href = routes.all_products_collection_url %}
              {% endif %}
            {% endif %}
            <a class="nav-link" href="{{ nav_href }}">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      </nav>
    </div>

    <div class="site-header__center"></div>

    <div class="site-header__right">
      <div class="site-header__meta">
        {% if section.settings.show_localization %}
          <span class="nav-link">
            {{ localization.country.name }}: {{ localization.country.currency.iso_code }}
          </span>
        {% endif %}
        {% if section.settings.trade_link != blank %}
          <a class="nav-link" href="{{ section.settings.trade_link }}">{{ section.settings.trade_label }}</a>
        {% endif %}
      </div>
      <div class="header-icons">
        <button type="button" class="header-icon-btn" data-ai-search-open aria-label="Ara" aria-haspopup="dialog" aria-controls="kuuine-ai-search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
        <a href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M5 19c1.5-3 4-4.5 7-4.5s5.5 1.5 7 4.5"/></svg>
        </a>
        <a href="{{ routes.cart_url }}" aria-label="Cart">
          <svg viewBox="0 0 24 24"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
        </a>
      </div>
    </div>
  </div>
  {% render 'mega-menu' %}
  {% render 'nav-drawer' %}
  {% render 'ai-search' %}
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_icon",
      "label": "Logo ikonu — koyu (swan)"
    },
    {
      "type": "image_picker",
      "id": "logo_icon_light",
      "label": "Logo ikonu — açık / hero (swan)"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo wordmark (koyu — açık zemin)"
    },
    {
      "type": "image_picker",
      "id": "logo_light",
      "label": "Logo wordmark (açık — hero üzeri)"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo alt metni",
      "default": "kuuine"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "transparent_over_home",
      "label": "Ana sayfada şeffaf header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Ülke / para birimini göster",
      "default": true
    },
    {
      "type": "text",
      "id": "trade_label",
      "label": "Ticari bağlantı etiketi",
      "default": "Ticari"
    },
    {
      "type": "url",
      "id": "trade_link",
      "label": "Ticari bağlantı"
    }
  ]
}
{% endschema %}

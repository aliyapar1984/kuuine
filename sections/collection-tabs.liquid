<section class="collection-tabs" data-tabs {{ section.shopify_attributes }}>
  <div class="collection-tabs__layout container">
    <div class="collection-tabs__gallery">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          {% if forloop.first %}
            {% assign tab_image_class = 'is-active' %}
          {% else %}
            {% assign tab_image_class = '' %}
          {% endif %}
          {{
            block.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              class: tab_image_class,
              data-tab-image: block.id,
              alt: block.settings.title
          }}
        {% endif %}
      {% endfor %}
    </div>
    <div class="collection-tabs__info">
      {% if section.settings.heading != blank %}
        <h2 class="collection-tabs__title">{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="collection-tabs__nav" role="tablist">
        {% for block in section.blocks %}
          <button
            type="button"
            class="{% if forloop.first %}is-active{% endif %}"
            data-tab="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.title }}
          </button>
        {% endfor %}
      </div>
      {% for block in section.blocks %}
        <div
          class="collection-tabs__panel {% if forloop.first %}is-active{% endif %}"
          data-panel="{{ block.id }}"
        >
          <p>{{ block.settings.text }}</p>
          {% if block.settings.link_label != blank %}
            <a class="btn--text" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection tabs",
  "tag": "section",
  "class": "section-collection-tabs",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Her sofra için zarafet"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Başlık", "default": "Tabaklar" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Metin",
          "default": "Soft premium stoneware tabaklar — ziyafet sofraları için zamansız formlar."
        },
        { "type": "image_picker", "id": "image", "label": "Görsel" },
        { "type": "text", "id": "link_label", "label": "Bağlantı metni", "default": "Tabakları keşfet" },
        { "type": "url", "id": "link", "label": "Bağlantı" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tabs",
      "blocks": [
        { "type": "tab", "settings": { "title": "Tabaklar" } },
        { "type": "tab", "settings": { "title": "Bardaklar" } },
        { "type": "tab", "settings": { "title": "Organik seramik" } },
        { "type": "tab", "settings": { "title": "Ziyafet setleri" } },
        { "type": "tab", "settings": { "title": "Kaseler" } }
      ]
    }
  ]
}
{% endschema %}

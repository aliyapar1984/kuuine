<section class="collection-tabs tw:bg-kuuine tw:py-[clamp(3rem,7vw,6rem)]" data-tabs {{ section.shopify_attributes }}>
  <div class="collection-tabs__layout container tw:grid tw:grid-cols-1 tw:items-center tw:gap-[clamp(1.5rem,4vw,3.5rem)] tw:lg:grid-cols-[1.1fr_0.9fr]">
    <div class="collection-tabs__gallery tw:relative tw:aspect-[3/4] tw:overflow-hidden tw:bg-kuuine-soft tw:lg:aspect-[4/5]">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          {% if forloop.first %}
            {% assign tab_image_class = 'is-active' %}
          {% else %}
            {% assign tab_image_class = '' %}
          {% endif %}
          {{
            block.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              class: tab_image_class,
              data-tab-image: block.id,
              alt: block.settings.title
          }}
        {% endif %}
      {% endfor %}
    </div>
    <div class="collection-tabs__info tw:grid tw:min-w-0 tw:grid-cols-1 tw:content-center">
      {% if section.settings.heading != blank %}
        <h2 class="collection-tabs__title tw:mb-6 tw:font-display tw:text-[clamp(28px,3.4vw,38px)] tw:font-normal tw:leading-[1.2] tw:tracking-[0.03em] tw:text-kuuine-ink">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      <div class="collection-tabs__nav" role="tablist">
        {% for block in section.blocks %}
          <button
            type="button"
            class="{% if forloop.first %}is-active{% endif %}"
            data-tab="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.title }}
          </button>
        {% endfor %}
      </div>
      {% for block in section.blocks %}
        <div
          class="collection-tabs__panel {% if forloop.first %}is-active{% endif %}"
          data-panel="{{ block.id }}"
        >
          <p class="tw:mb-6 tw:max-w-[40ch] tw:text-[15px] tw:leading-[1.7] tw:text-kuuine-ink">
            {{ block.settings.text }}
          </p>
          {% if block.settings.link_label != blank %}
            <a class="btn--text" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection tabs",
  "tag": "section",
  "class": "section-collection-tabs",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Başlık",
      "default": "Her sofra için zarafet"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Başlık", "default": "Tabaklar" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Metin",
          "default": "Soft premium stoneware tabaklar — ziyafet sofraları için zamansız formlar."
        },
        { "type": "image_picker", "id": "image", "label": "Görsel" },
        { "type": "text", "id": "link_label", "label": "Bağlantı metni", "default": "Tabakları keşfet" },
        { "type": "url", "id": "link", "label": "Bağlantı" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tabs",
      "blocks": [
        { "type": "tab", "settings": { "title": "Tabaklar" } },
        { "type": "tab", "settings": { "title": "Bardaklar" } },
        { "type": "tab", "settings": { "title": "Organik seramik" } },
        { "type": "tab", "settings": { "title": "Ziyafet setleri" } },
        { "type": "tab", "settings": { "title": "Kaseler" } }
      ]
    }
  ]
}
{% endschema %}
